# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Vectorstore database files (regenerated via ingest.py)
vectorstore/

# Environments and credentials
.env
.env.local
.env.*
venv/
.venv/
env/
ENV/

# OS-specific files
Thumbs.db
db.properties
.DS_Store

# IDEs
.vscode/
.idea/

# Ignore all files in documents/ except the folder structure itself
documents/*
!documents/.gitkeep

# Ignore report drafts, presentations, and PDFs in root
*.pdf
*.docx
*.pptx

